# proto-file: task_builder.proto
# proto-message: TaskConfig

# Task Configuration in pbtxt format
mode: ANALYTICS
population_name: "jetbrains/nightly/intellij_idea"
use_daf: true

# Policies
policies {
  min_separation_policy {
    minimum_separation: 0  # Minimum participated round distance for the same client
  }
  data_availability_policy {
    min_example_count: 1  # Minimum examples required
  }
  model_release_policy {
    num_max_training_rounds: 1 # number of rounds (iterations)
  }
}

federated_learning {
  learning_process {
    runtime_config {
      example_selector_uri: "app://federatedCompute/selfTest"
      report_goal: 1 # how many clients will participate in training for each round
      over_selection_rate: 0 # extra client number ratio above report_goal
      # todo: acceptable versions, now hardcoded
    }
  }
}